"use client";

import { useState, useEffect } from "react";
import Link from "next/link";
import { motion } from "framer-motion";
import { HiSearch, HiOutlineLightningBolt, HiOutlineShieldCheck, HiOutlineUserGroup } from "react-icons/hi";
import Button from "@/components/common/Button";
import Input from "@/components/common/Input";
import PropertyCard from "@/components/property/PropertyCard";
import developmentService from "@/services/developmentService";
import { Loader } from "@/components/common/Loader";

export default function LandingPage() {
  const [featured, setFeatured] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchFeatured = async () => {
      try {
        const data = await developmentService.getFeatured();
        setFeatured(data);
      } catch (error) {
        console.error("Error fetching featured developments:", error);
      } finally {
        setLoading(false);
      }
    };
    fetchFeatured();
  }, []);

  return (
    <div className="flex flex-col gap-24 pb-24">
      {/* Hero Section */}
      <section className="relative h-[90vh] min-h-[600px] flex items-center justify-center overflow-hidden">
        {/* Background Overlay */}
        <div className="absolute inset-0 z-0">
          <img 
            src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2000&auto=format&fit=crop" 
            alt="Hero" 
            className="w-full h-full object-cover"
          />
          <div className="absolute inset-0 bg-gradient-to-r from-white via-white/80 to-transparent" />
        </div>

        <div className="container mx-auto px-4 relative z-10">
          <motion.div 
            initial={{ opacity: 0, x: -50 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.8 }}
            className="max-w-2xl"
          >
            <h1 className="text-5xl md:text-7xl font-extrabold text-gray-900 leading-tight mb-6">
              Find Your Perfect <span className="text-blue-600">Home</span> with AI Precision.
            </h1>
            <p className="text-xl text-gray-600 mb-8 leading-relaxed">
              PreLease AI helps you discover premium developments, match with your ideal lifestyle, 
              and manage your entire leasing journey in one seamless platform.
            </p>

            <div className="bg-white p-2 rounded-2xl shadow-2xl flex flex-col md:flex-row items-center gap-2 max-w-xl">
              <div className="flex-1 w-full relative">
                <HiSearch className="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 w-5 h-5" />
                <input 
                  type="text" 
                  placeholder="Where do you want to live?" 
                  className="w-full pl-12 pr-4 py-4 bg-transparent focus:outline-none text-gray-900"
                />
              </div>
              <Button size="lg" className="w-full md:w-auto px-10">
                Search
              </Button>
            </div>

            <div className="mt-8 flex items-center space-x-6">
              <div className="flex -space-x-3">
                {[1, 2, 3, 4].map((i) => (
                  <img 
                    key={i}
                    src={`https://i.pravatar.cc/150?u=${i}`} 
                    alt="User" 
                    className="w-10 h-10 rounded-full border-2 border-white"
                  />
                ))}
              </div>
              <p className="text-sm text-gray-500">
                <span className="font-bold text-gray-900">1,000+</span> tenants already found their home
              </p>
            </div>
          </motion.div>
        </div>
      </section>

      {/* Featured Developments */}
      <section className="container mx-auto px-4">
        <div className="flex flex-col md:flex-row items-end justify-between mb-12 gap-6">
          <div className="max-w-xl">
            <h2 className="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Featured Developments</h2>
            <p className="text-gray-500 text-lg">
              Hand-picked premium living spaces that offer the best amenities and locations.
            </p>
          </div>
          <Link href="/find-a-home">
            <Button variant="outline">View All Properties</Button>
          </Link>
        </div>

        {loading ? (
          <Loader className="py-20" />
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {featured.map((property, index) => (
              <motion.div
                key={property.id}
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: index * 0.1 }}
              >
                <PropertyCard property={property} />
              </motion.div>
            ))}
          </div>
        )}
      </section>

      {/* How It Works */}
      <section className="bg-gray-50 py-24">
        <div className="container mx-auto px-4 text-center">
          <h2 className="text-3xl md:text-4xl font-bold text-gray-900 mb-16">How PreLease Works</h2>
          <div className="grid grid-cols-1 md:grid-cols-3 gap-12">
            {[
              {
                icon: HiSearch,
                title: "Smart Search",
                desc: "Tell us your preferences and our AI will find the best matches for you."
              },
              {
                icon: HiOutlineLightningBolt,
                title: "Instant Match",
                desc: "Get a compatibility score for every property based on your lifestyle."
              },
              {
                icon: HiOutlineShieldCheck,
                title: "Easy Leasing",
                desc: "Book viewings and complete your lease application entirely online."
              }
            ].map((step, i) => (
              <div key={i} className="flex flex-col items-center">
                <div className="w-20 h-20 bg-blue-100 rounded-3xl flex items-center justify-center mb-6 text-blue-600">
                  <step.icon className="w-10 h-10" />
                </div>
                <h3 className="text-xl font-bold mb-4">{step.title}</h3>
                <p className="text-gray-500 leading-relaxed max-w-xs">{step.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Benefits */}
      <section className="container mx-auto px-4 py-12">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
          <div>
            <h2 className="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
              Why Choose PreLease AI?
            </h2>
            <div className="space-y-8">
              {[
                {
                  title: "AI-Powered Recommendations",
                  desc: "We don't just show listings; we find your future home based on data-driven matches.",
                  icon: HiOutlineLightningBolt
                },
                {
                  title: "Verified Premium Developments",
                  desc: "Every property on our platform is vetted for quality and reliability.",
                  icon: HiOutlineShieldCheck
                },
                {
                  title: "Community First Approach",
                  desc: "Connect with like-minded neighbors before you even move in.",
                  icon: HiOutlineUserGroup
                }
              ].map((benefit, i) => (
                <div key={i} className="flex gap-6">
                  <div className="flex-shrink-0 w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600">
                    <benefit.icon className="w-6 h-6" />
                  </div>
                  <div>
                    <h4 className="text-xl font-bold text-gray-900 mb-2">{benefit.title}</h4>
                    <p className="text-gray-500 leading-relaxed">{benefit.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div className="relative">
            <div className="bg-blue-600 absolute -inset-4 rounded-3xl opacity-10 rotate-3" />
            <img 
              src="https://images.unsplash.com/photo-1574362848149-11496d93a7c7?q=80&w=1000&auto=format&fit=crop" 
              alt="Luxury Living" 
              className="relative rounded-3xl shadow-2xl w-full h-[500px] object-cover"
            />
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section className="container mx-auto px-4">
        <div className="bg-blue-600 rounded-[3rem] p-12 md:p-20 text-center text-white relative overflow-hidden">
          {/* Decorative circles */}
          <div className="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-32 -mt-32" />
          <div className="absolute bottom-0 left-0 w-64 h-64 bg-white/10 rounded-full -ml-32 -mb-32" />

          <h2 className="text-4xl md:text-5xl font-bold mb-8 relative z-10">
            Ready to Find Your Next Home?
          </h2>
          <p className="text-blue-100 text-xl mb-12 max-w-2xl mx-auto relative z-10">
            Join thousands of happy tenants who found their perfect living space through PreLease AI.
          </p>
          <div className="flex flex-col sm:flex-row items-center justify-center gap-4 relative z-10">
            <Link href="/register">
              <Button size="lg" variant="secondary" className="px-10 py-6 text-blue-600">
                Create Free Account
              </Button>
            </Link>
            <Link href="/find-a-home">
              <Button size="lg" variant="outline" className="px-10 py-6 border-white text-white hover:bg-white/10">
                Browse Properties
              </Button>
            </Link>
          </div>
        </div>
      </section>
    </div>
  );
}
